{
  "name": "Telegram Audio Transcription",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "telegram-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-voice",
              "leftValue": "={{ $json.message && $json.message.voice ? 'has-voice' : 'no-voice' }}",
              "rightValue": "has-voice",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "has-audio",
              "leftValue": "={{ $json.message && $json.message.audio ? 'has-audio' : 'no-audio' }}",
              "rightValue": "has-audio",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-has-audio",
      "name": "IF - Has Audio",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile",
        "options": {
          "qs": {
            "file_id": "={{ $json.message.voice ? $json.message.voice.file_id : $json.message.audio.file_id }}"
          }
        }
      },
      "id": "get-file-info",
      "name": "Get File Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get file path from Telegram API response\nconst filePath = $input.item.json.result.file_path;\nconst botToken = $env.TELEGRAM_BOT_TOKEN;\n\n// Build full file URL\nconst fileUrl = `https://api.telegram.org/file/bot${botToken}/${filePath}`;\n\n// Get chat ID from original message\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst messageId = $('Telegram Trigger').item.json.message.message_id;\n\n// Detect language from message or use default\nlet language = 'pt'; // Default to Portuguese\nif ($('Telegram Trigger').item.json.message.from && $('Telegram Trigger').item.json.message.from.language_code) {\n  language = $('Telegram Trigger').item.json.message.from.language_code;\n}\n\nreturn {\n  fileUrl,\n  chatId,\n  messageId,\n  language,\n  fileName: filePath ? filePath.split('/').pop() : 'audio.ogg'\n};"
      },
      "id": "build-file-url",
      "name": "Build File URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8484/transcribe-url",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.fileUrl }}"
            },
            {
              "name": "language",
              "value": "={{ $json.language }}"
            }
          ]
        },
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "id": "transcribe-audio",
      "name": "Transcribe Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-error",
              "leftValue": "={{ $json.error || $json.detail }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-error",
      "name": "IF - Has Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Build File URL').item.json.chatId }}",
        "text": "=❌ *Erro na Transcrição*\n\n{{ $json.error || $json.detail || 'Erro desconhecido' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-error",
      "name": "Send Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1450,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Build File URL').item.json.chatId }}",
        "text": "=🎤 *Transcrição Concluída*\n\n*Idioma:* {{ $json.language }}\n\n*Texto:*\n{{ $json.text }}\n\n_Processado em {{ $json.segments.length }} segmentos_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-result",
      "name": "Send Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1450,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Build File URL').item.json.chatId }}",
        "text": "=ℹ️ Esta mensagem não contém áudio. Por favor, envie uma mensagem de voz ou um arquivo de áudio.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-no-audio",
      "name": "Send No Audio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        650,
        500
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "IF - Has Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Has Audio": {
      "main": [
        [
          {
            "node": "Get File Info",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send No Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get File Info": {
      "main": [
        [
          {
            "node": "Build File URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build File URL": {
      "main": [
        [
          {
            "node": "Transcribe Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcribe Audio": {
      "main": [
        [
          {
            "node": "IF - Has Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Has Error": {
      "main": [
        [
          {
            "node": "Send Error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2024-01-01T00:00:00.000Z",
  "versionId": "1"
}

